{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "entity_id",
          "status",
          "source",
          "checks"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "published-unverified",
              "conflicting",
              "obsolete",
              "unknown"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "artifact",
              "locator"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "scope_regex": {
                "type": "string",
                "minLength": 1
              },
              "required_text": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "forbidden_text": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preserve_snippet_context": {
                "type": "boolean"
              }
            },
            "required": [
              "scope_regex",
              "required_text"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "description": "Business attributes remain extensible; runtime checks are diagnostic and do not establish semantic truth."
}
