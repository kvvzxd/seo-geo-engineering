{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "enum": [
        "production",
        "staging"
      ]
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "ownership": {
      "enum": [
        "whole_file",
        "managed_block"
      ]
    },
    "bot_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "user_agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "directive": {
                  "enum": [
                    "Allow",
                    "Disallow"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/|^$"
                }
              },
              "required": [
                "directive",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "user_agents",
          "rules"
        ],
        "additionalProperties": false
      }
    },
    "sitemaps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "critical_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "const": "google"
          },
          "expected_crawl": {
            "enum": [
              "allow",
              "disallow"
            ]
          },
          "expected_indexing": {
            "enum": [
              "blocked",
              "no_blocking_directive"
            ]
          },
          "capture": {
            "type": "object"
          }
        },
        "required": [
          "url",
          "token",
          "profile",
          "expected_crawl"
        ],
        "additionalProperties": false
      }
    },
    "llms": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "environment",
    "origin",
    "ownership",
    "bot_groups",
    "critical_urls"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Additional runtime checks enforce same origin, newline safety, active capture and supported semantics. This schema alone is not sufficient."
}
